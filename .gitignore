# =============================================================================
# MaternaCare AI — .gitignore
# =============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
virtualenv/

# Generated model artifacts (regenerated by running main.py)
models/*.joblib
models/*.pkl
models/*.model

# Generated figures (regenerated by running main.py)
figures/*.png
figures/*.jpg
figures/*.svg
figures/*.pdf

# Local dataset copy (downloaded from UCI on first run; keep if you want offline)
# maternal_health_risk.csv

# Environment & secrets
.env
.env.local
.env.*.local
*.env

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
logs/
*.out

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
pip-wheel-metadata/

# Coverage & test artifacts
.coverage
coverage/
htmlcov/
.tox/
.nox/

# Jupyter / notebooks (if any)
.ipynb_checkpoints/
*.ipynb

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup

# =============================================================================
# Notes:
# - Run `python main.py` to regenerate figures/ and models/mhrlc_model.joblib
# - Run `python app.py` to start the web server (requires model + figures)
# - The UCI dataset (maternal_health_risk.csv) is auto-downloaded if missing
# =============================================================================